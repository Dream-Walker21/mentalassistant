# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Logging: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Embedding model: local=本地 BGE-M3（需下载2GB模型），api=调embedding API
EMBEDDING_PROVIDER=local
# API 模式（如硅基流动免费提供 BGE-M3）：
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_MODEL=BAAI/bge-m3

# Alert service
ALERT_HTTP_URL=http://127.0.0.1:5000/alert
ALERT_API_TOKEN=
ALERT_CHANNEL=log
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENTS=
ALERT_DB_URL=postgresql://xinqing:xinqing@localhost:5432/xinqing
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now

# User data service. Both the alert service and the data service can share the
# same PostgreSQL database; their table names do not conflict.
DATA_DB_URL=postgresql://xinqing:xinqing@localhost:5432/xinqing
DATA_API_TOKEN=
DATA_HOST=127.0.0.1
DATA_PORT=8001

# JWT auth (data_service is the sole gateway, verifies JWT here)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Service-to-service key (data_service -> langgraph/alert)
SERVICE_API_KEY=

# Reserved for the future GPT-SoVITS adapter. The current API only records
# requests and returns a clear not-configured response.
GPT_SOVITS_BASE_URL=

# TTS provider: edge (lightweight, for testing) or gpt_sovits (HTTP, production)
TTS_PROVIDER=edge
# edge-tts voice name (default: a warm Mandarin female voice)
TTS_VOICE=zh-CN-XiaoxiaoNeural
# Directory for generated audio files (relative to project root in dev;
# set an absolute path like /var/xinqing/audio in production)
XINQING_AUDIO_DIR=data/audio

# Optional: override the local ASCII-safe Chroma path
# XINQING_RAG_DIR=
# Middleware service (the sole backend entry for the frontend)
MIDDLEWARE_HOST=127.0.0.1
MIDDLEWARE_PORT=8000
# LangGraph API URL; override if the workflow runs on a different host/port
LANGGRAPH_API_URL=http://127.0.0.1:2024
