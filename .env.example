# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alert service
ALERT_HTTP_URL=http://127.0.0.1:5000/alert
ALERT_API_TOKEN=
ALERT_CHANNEL=log
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENTS=
ALERT_DB_PATH=./data/alert_data.sqlite3
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now

# User data service. Keep this separate from the alert database because it
# contains conversation history and user-controlled preferences.
DATA_DB_PATH=./data/assistant_data.sqlite3
DATA_API_TOKEN=
DATA_HOST=127.0.0.1
DATA_PORT=8001

# Reserved for the future GPT-SoVITS adapter. The current API only records
# requests and returns a clear not-configured response.
GPT_SOVITS_BASE_URL=

# Optional: override the local ASCII-safe Chroma path
# XINQING_RAG_DIR=
